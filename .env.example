# Wallet
# Base58 secret key (~88 characters), a JSON array of 64 bytes, or a 12/24-word seed phrase.
# A 32-byte / ~44-character public key is rejected at startup. The value is never logged.
PRIVATE_KEY=

# Connection
# A private RPC is strongly recommended. Public mainnet RPC often drops program log subscriptions.
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Bot
LOG_LEVEL=info
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=false
# default or warp or jito. Ignored while DRY_RUN=true.
TRANSACTION_EXECUTOR=default
# Priority fee for the default executor.
COMPUTE_UNIT_LIMIT=250000
COMPUTE_UNIT_PRICE=200000
# Tip for warp or jito, in SOL. Jito's competitive tip changes; 0.0006 is a low starting point.
CUSTOM_FEE=0.0006
# Build and sign transactions locally, then discard them. Start here before using a funded wallet.
DRY_RUN=false
# Reclaim rent from token accounts that are already empty, and close the account on a full sell.
CLOSE_EMPTY_TOKEN_ACCOUNTS=true
# Wait this many milliseconds times the attempt number before the next buy/sell retry. Each retry uses a new blockhash.
RETRY_BACKOFF_MS=400

# Venues. Each can be enabled on its own. Pump venues are off when the variable is omitted.
ENABLE_RAYDIUM=true
ENABLE_PUMPFUN=true
ENABLE_PUMPSWAP=true

# Buy
QUOTE_MINT=WSOL
# 0.001 SOL is smaller than token-account rent (~0.00203928 SOL) and cannot be profitable.
QUOTE_AMOUNT=0.05
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=3
BUY_SLIPPAGE=20

# Sell
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
# Heartbeat for take-profit / stop-loss. Websocket account updates also wake the check when PRICE_CHECK_WEBSOCKET=true.
PRICE_CHECK_INTERVAL=750
PRICE_CHECK_DURATION=600000
PRICE_CHECK_WEBSOCKET=true
TAKE_PROFIT=40
STOP_LOSS=20
SELL_SLIPPAGE=30
# Added to SELL_SLIPPAGE on each failed sell. The last attempt accepts any output.
SELL_SLIPPAGE_STEP=10

# Raydium filters. These do not run for pump.fun or PumpSwap.
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=1
CHECK_IF_MUTABLE=true
CHECK_IF_SOCIALS=false
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=true
CHECK_IF_BURNED=true
MIN_POOL_SIZE=5
MAX_POOL_SIZE=50

# pump.fun filters. A bound of 0 disables that check (curve-progress max defaults to 100, which allows the whole curve).
# Dev buy is the spot SOL value of the creator's token balance. Unique buyers are counted from buy events seen since startup.
PUMP_MIN_CURVE_PROGRESS=0
PUMP_MAX_CURVE_PROGRESS=100
PUMP_MIN_MARKET_CAP_SOL=0
PUMP_MAX_MARKET_CAP_SOL=0
PUMP_MIN_DEV_BUY_SOL=0
PUMP_MAX_DEV_BUY_SOL=0
PUMP_MAX_CREATOR_HOLD_PERCENT=0
PUMP_MIN_UNIQUE_BUYERS=0
PUMP_BUYER_WAIT_MS=0
PUMP_MAX_REAL_SOL=0
PUMP_SKIP_MAYHEM=true
# Non-SOL quotes are recognized and skipped. Buys are SOL-only.
PUMP_ALLOW_NON_SOL_QUOTE=false
# One base58 creator per line. Blank lines and # comments are ignored. Missing file means an empty list.
PUMP_CREATOR_BLACKLIST=pump-creator-blacklist.txt
